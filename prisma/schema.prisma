generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String @id @default(cuid())
  username String @unique
}

model Vaccine {
  id              Int      @id @default(autoincrement())
  gamefowlId      Int
  vaccinationDate DateTime
  notes           String
  name            String?
  isArchived      Boolean  @default(false)
  gamefowl        Gamefowl @relation(fields: [gamefowlId], references: [id])
}

model Breeding {
  id         Int            @id @default(autoincrement())
  sireId     Int
  damId      Int
  notes      String
  status     BreedingStatus
  endDate    DateTime?
  startDate  DateTime?
  isArchived Boolean        @default(false)
  dam        Gamefowl       @relation("DamBreeding", fields: [damId], references: [id])
  sire       Gamefowl       @relation("SireBreeding", fields: [sireId], references: [id])
}

model Deworming {
  id         Int      @id @default(autoincrement())
  gamefowlId Int
  dewormDate DateTime
  notes      String
  name       String?
  isArchived Boolean  @default(false)
  gamefowl   Gamefowl @relation(fields: [gamefowlId], references: [id])
}

model Sparring {
  id                Int      @id @default(autoincrement())
  gamefowl_1_Id     Int
  gamefowl_2_Id     Int
  winnerId          Int
  loserId           Int
  winner_elo_change Int
  loser_elo_change  Int
  sparringDate      DateTime
  notes             String
  gamefowl1         Gamefowl @relation("Gamefowl1", fields: [gamefowl_1_Id], references: [id])
  gamefowl2         Gamefowl @relation("Gamefowl2", fields: [gamefowl_2_Id], references: [id])
  loser             Gamefowl @relation("SparLose", fields: [loserId], references: [id])
  winner            Gamefowl @relation("SparWin", fields: [winnerId], references: [id])
}

model Gamefowl {
  id              Int            @id @default(autoincrement())
  name            String
  bloodline       String
  date_hatched    DateTime?
  date_sold       DateTime?
  /// *
  /// * Parent ID Relations
  sireId          Int?
  damId           Int?
  batchId         Int?
  /// *
  /// * End of Parent ID Relations
  createdAt       DateTime       @default(now())
  img             String?
  age             gamefowlAge?
  isArchived      Boolean        @default(false)
  eloRating       Int            @default(1000)
  sex             GamefowlSex
  damBreeding     Breeding[]     @relation("DamBreeding")
  sireBreeding    Breeding[]     @relation("SireBreeding")
  conditioning    Conditioning[] @relation("Conditioning")
  deworming       Deworming[]
  dam             Gamefowl?      @relation("DamRelation", fields: [damId], references: [id])
  offspringDam    Gamefowl[]     @relation("DamRelation")
  sire            Gamefowl?      @relation("SireRelation", fields: [sireId], references: [id])
  offspringSire   Gamefowl[]     @relation("SireRelation")
  sparring_1      Sparring[]     @relation("Gamefowl1")
  sparring_2      Sparring[]     @relation("Gamefowl2")
  sparring_loser  Sparring[]     @relation("SparLose")
  sparring_winner Sparring[]     @relation("SparWin")
  vaccine         Vaccine[]
}

model OneTimeSched {
  id          Int      @id @default(autoincrement())
  schedId     Int
  taskName    String
  taskDate    DateTime
  time_of_day String
  schedule    Schedule @relation("OneTime", fields: [schedId], references: [id])
}

model ConditioningProgram {
  id           Int                    @id @default(autoincrement())
  programName  String
  description  String
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  Conditioning Conditioning[]
  activities   ConditioningActivity[]
}

model ConditioningActivity {
  id          Int                 @id @default(autoincrement())
  name        String
  description String
  programId   Int
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  program     ConditioningProgram @relation(fields: [programId], references: [id])
}

model Conditioning {
  id         Int                 @id @default(autoincrement())
  eventId    Int
  conProgId  Int
  gamefowlId Int
  handlerId  String
  startDate  DateTime
  endDate    DateTime
  status     ConditioningStatus
  conProg    ConditioningProgram @relation(fields: [conProgId], references: [id])
  event      Event               @relation(fields: [eventId], references: [id])
  gamefowl   Gamefowl            @relation("Conditioning", fields: [gamefowlId], references: [id])
  handler    Handler             @relation(fields: [handlerId], references: [id])
}

model Batch {
  id                Int        @id @default(autoincrement())
  incubate_sched_id Int
  eggCount          Int
  fertilityRate     Float
  hatchRate         Float
  dateHatched       DateTime
  incubation        Incubation @relation(fields: [incubate_sched_id], references: [id])
}

model Incubation {
  id           Int              @id @default(autoincrement())
  incStart     DateTime
  incEnd       DateTime
  turningSched DateTime
  status       IncubationStatus
  batch        Batch[]
}

model Schedule {
  id           Int                  @id @default(autoincrement())
  taskName     String
  taskType     TaskType
  taskCategory TaskCategory
  descript     String
  staffId      String?
  staffType    UserRole?
  status       EventStatus          @default(PLANNED)
  oneTime      OneTimeSched[]       @relation("OneTime")
  recurrent    RecurrentSchedules[]
}

model Handler {
  id           String         @id @default(cuid())
  username     String         @unique
  password     String
  first_name   String
  middle_name  String?
  last_name    String
  email        String?        @unique
  img          String?
  phone        String?
  role         UserRole
  status       UserStatus
  createdAt    DateTime       @default(now())
  isArchived   Boolean        @default(false)
  conditioning Conditioning[]
  event        Event[]
}

model Breeder {
  id          String     @id @default(cuid())
  username    String     @unique
  password    String
  first_name  String
  last_name   String
  email       String?    @unique
  img         String?
  phone       String?
  role        UserRole   @default(BREEDER)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  middle_name String?
  isArchived  Boolean    @default(false)
}

model Event {
  id           Int            @id @default(autoincrement())
  eventName    String
  eventType    EventType
  ageCategory  AgeCategory
  eventDate    DateTime
  description  String
  status       EventStatus
  handlerId    String?
  conditioning Conditioning[]
  handler      Handler?       @relation(fields: [handlerId], references: [id])
}

model RecurrentSchedules {
  id                Int               @id @default(autoincrement())
  schedId           Int
  reccurencePattern RecurrencePattern
  startDate         DateTime
  endDate           DateTime
  time_of_day       String
  weekDays          String? // Store selected days of the week as a JSON string
  schedule          Schedule          @relation(fields: [schedId], references: [id])
}

/// *
/// * ENUMS
enum UserRole {
  OWNER
  HANDLER
  BREEDER
}

enum UserStatus {
  ACTIVE
  RESIGNED
}

enum TaskType {
  RECURRING
  ONETIME
}

enum TaskCategory {
  FEEDING
  VACCINATION
  DEWORMING
}

enum BreedingStatus {
  ONGOING
  FINISHED
}

enum ConditioningStatus {
  PLANNED
  ONGOING
  COMPLETED
}

enum IncubationStatus {
  ONGOING
  FINISHED
}

enum EventType {
  THREE_COCK_DERBY
  FOUR_COCK_DERBY
  FIVE_COCK_DERBY
  SOLO
}

enum AgeCategory {
  STAG
  BULLSTAG
  COCK
  ANY
}

enum EventStatus {
  PLANNED
  ONGOING
  FINISHED
}

enum RecurrencePattern {
  DAILY
  WEEKLY
  MONTHLY
}

enum gamefowlAge {
  CHICK
  STAG
  BULLSTAG
  COCK
  PULLET
  HEN
}

enum GamefowlSex {
  MALE
  FEMALE
}
